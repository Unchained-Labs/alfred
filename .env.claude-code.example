# Source these before bringing the stack up with the Claude Code override:
#   export CLAUDE_BIN=$(readlink -f ~/.local/bin/claude)
#   export CLAUDE_HOME=$HOME/.claude
#   docker compose -f docker-compose.yml -f docker-compose.claude-code.yml up -d
CLAUDE_BIN=/home/you/.local/share/claude/versions/2.1.285
CLAUDE_HOME=/home/you/.claude
