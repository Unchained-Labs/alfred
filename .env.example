# Alfred — environment overrides
#
# Everything here is optional: the same values can be set in the Settings UI,
# which stores them in the local SQLite database. Environment variables win
# where both are present.

# --- Database -------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/alfred.db
# ALFRED_DB_PATH=./data/alfred.db

# --- AI provider: Claude --------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- AI provider: OpenAI-compatible endpoint ------------------------------
# Base URL and model are set in Settings; only the key is read from here.
# ALFRED_LLM_API_KEY=...

# --- AI provider: custom agent --------------------------------------------
# Sent as `Authorization: Bearer <token>` to your agent endpoint.
# ALFRED_AGENT_API_KEY=...

# ── Sign-in (passkeys) ────────────────────────────────────────────────────
# Alfred signs in with passkeys: Face ID, Touch ID, Windows Hello, a security
# key, or your phone by QR code. Passwords still work for accounts created
# before passkeys existed; new accounts never get one.
#
# A passkey is bound to the hostname it was created on, so behind a proxy or a
# tailnet these MUST be the address the browser actually shows. Get them wrong
# and nothing errors — the passkey is simply never offered and sign-in looks
# broken for no reason.
# ALFRED_PUBLIC_URL=https://alfred.example.com
# ALFRED_RP_ID=alfred.example.com
#
# Passkeys also need a secure context: https, or http on localhost. Plain http
# on a LAN address cannot do them at all.
#
# Who may create an account. The FIRST one is always allowed — that is how the
# owner is made. After that, sign-up is closed unless this is on, and people
# join by invitation instead. Turn it on only if everyone who can reach Alfred
# should be able to have an account on it.
# ALFRED_ALLOW_SIGNUP=0

# Timezone for the SERVER's idea of today. The container is UTC by default, so
# east of UTC the app's "today" is your yesterday for part of every night —
# which makes due dates and "overdue" wrong rather than merely off.
# TZ=Europe/Paris
