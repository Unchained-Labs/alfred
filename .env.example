# Alfred — environment overrides
#
# Everything here is optional: the same values can be set in the Settings UI,
# which stores them in the local SQLite database. Environment variables win
# where both are present.

# --- Database -------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/alfred.db
# ALFRED_DB_PATH=./data/alfred.db

# --- AI provider: Claude --------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- AI provider: OpenAI-compatible endpoint ------------------------------
# Base URL and model are set in Settings; only the key is read from here.
# ALFRED_LLM_API_KEY=...

# --- AI provider: custom agent --------------------------------------------
# Sent as `Authorization: Bearer <token>` to your agent endpoint.
# ALFRED_AGENT_API_KEY=...
